# === OBRIGATÓRIA ===
# Chave Groq — geração de respostas com Llama 3 (GRATUITO em console.groq.com)
# Cadastro em 2 minutos, sem cartão de crédito
GROQ_API_KEY=gsk_...

# === CONFIGURADAS AUTOMATICAMENTE PELO DOCKER ===
DATABASE_URL=postgresql+asyncpg://bookmind:bookmind@db:5432/bookmind
REDIS_URL=redis://redis:6379

# === CONFIGURAÇÃO DO PIPELINE RAG (opcionais — não altere sem motivo) ===
# Modelo de embeddings local (fastembed, sem API key, suporte a português)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Modelo de geração via Groq (gratuito)
GENERATION_MODEL=llama-3.3-70b-versatile
# Quantas anotações buscar antes de gerar a resposta
RAG_TOP_K=5
